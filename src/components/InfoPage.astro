---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** i18n 全量 messages */
  messages: Record<string, any>;
  /** i18n messages.pages.<key> 的内容对象 */
  doc: any;
  /** 当前页 slug，用于生成同站专项页互链 */
  slug?: string;
}
const { lang, messages, doc, slug } = Astro.props;
const homeHref = `/${lang}/`;

const keyBySlug: Record<string, string> = {
  'entrance-fee': 'entranceFee',
  'khao-sok-map': 'map',
  'best-time-to-visit': 'bestTime',
  'jungle-trekking': 'trekking',
  'floating-bungalows': 'bungalows',
  'getting-there': 'transport',
  'khao-sok-from-phuket-krabi': 'trips',
  'cheow-lan-lake': 'lake',
};
const siblingLinks = slug
  ? Object.keys(keyBySlug)
      .filter((s) => s !== slug)
      .map((s) => ({ label: messages.pages[keyBySlug[s]].breadcrumb, href: `/${lang}/${s}/` }))
  : [];
---

<!-- 专项内容页版式：标题区 → 关键信息 → 表格 → 正文 → FAQ → 相关链接 -->
<main>
  <section id="overview" class="pt-28 pb-12 bg-teakDeep text-ivory">
    <div class="max-w-5xl mx-auto px-5">
      <p class="font-hand text-gold text-xl md:text-2xl">{doc.eyebrow}</p>
      <h1 class="font-display font-semibold text-3xl md:text-5xl mt-2 leading-tight">{doc.heading}</h1>
      <p class="mt-5 max-w-3xl text-ivory/80 leading-relaxed">{doc.lead}</p>
      <a
        href={homeHref}
        class="mt-7 inline-flex items-center gap-2 text-sm text-goldBright border border-gold/40 rounded-full px-5 py-2 hover:bg-gold hover:text-teak transition-colors"
      >
        ← {doc.backHome}
      </a>
    </div>
  </section>

  <section class="py-12 bg-ivory">
    <div class="max-w-5xl mx-auto px-5">
      <h2 class="font-display text-2xl md:text-3xl text-teak">{doc.factsTitle}</h2>
      <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {doc.facts.map((f: any) => (
          <div class="rounded-xl border border-teak/15 bg-white/50 p-4">
            <div class="text-xs uppercase tracking-wider text-teak/60">{f.label}</div>
            <div class="mt-1 font-medium text-ink/90 leading-snug">{f.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {doc.tableTitle && (
    <section class="pb-12 bg-ivory">
      <div class="max-w-5xl mx-auto px-5">
        <h2 class="font-display text-2xl md:text-3xl text-teak">{doc.tableTitle}</h2>
        <div class="mt-5 overflow-x-auto rounded-xl border border-teak/15">
          <table class="w-full min-w-[600px] text-sm border-collapse">
            <thead class="bg-teak text-ivory">
              <tr>
                {doc.tableHead.map((th: string) => (
                  <th class="text-left font-medium px-4 py-3 whitespace-nowrap">{th}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {doc.tableRows.map((row: string[], i: number) => (
                <tr class={i % 2 ? 'bg-white/30' : 'bg-white/60'}>
                  {row.map((cell) => (
                    <td class="px-4 py-3 align-top border-t border-teak/10 text-ink/85">{cell}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="pb-14 bg-ivory">
    <div class="max-w-5xl mx-auto px-5 space-y-9">
      {doc.sections.map((s: any, i: number) => (
        <article id={`s${i + 1}`}>
          <h2 class="font-display text-xl md:text-2xl text-teak">{s.h}</h2>
          {s.p && <p class="mt-2 text-ink/85 leading-relaxed">{s.p}</p>}
          {s.list && (
            <ul class="mt-3 space-y-2 text-sm text-ink/80">
              {s.list.map((li: string) => (
                <li class="flex gap-2">
                  <span class="text-gold shrink-0">▪</span>
                  <span>{li}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section id="faq" class="py-14 bg-teakDeep text-ivory">
    <div class="max-w-5xl mx-auto px-5">
      <h2 class="font-display text-2xl md:text-3xl">{doc.faqTitle}</h2>
      <div class="mt-6 space-y-3">
        {doc.faqs.map((f: any) => (
          <details class="rounded-xl border border-gold/20 bg-white/5 p-5">
            <summary class="cursor-pointer font-medium text-ivory marker:text-gold">{f.q}</summary>
            <p class="mt-2 text-sm text-ivory/80 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>

      <p class="mt-6 text-xs text-ivory/50 leading-relaxed">{doc.note}</p>

      <div class="ornament my-8 opacity-60"></div>

      <h2 class="font-display text-xl">{doc.relatedTitle}</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={homeHref}
          class="rounded-full border border-gold/50 px-5 py-2 text-sm hover:bg-gold hover:text-teak transition-colors"
        >
          {doc.backHome}
        </a>
        {siblingLinks.map((r) => (
          <a
            href={r.href}
            class="rounded-full border border-gold/50 px-5 py-2 text-sm hover:bg-gold hover:text-teak transition-colors"
          >
            {r.label} →
          </a>
        ))}
      </div>
    </div>
  </section>
</main>
