---
import { expansion } from '../data/expansion';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const picks = ['sok-river','ton-kloi-waterfall','rafflesia-flower','three-brothers-rocks','coral-cave','two-day-itinerary'];
const cards = picks.map(slug => expansion.find(e => e[0] === slug)!);
const heading = { en:'Explore more around Khao Sok', th:'เที่ยวต่อรอบเขาสก', zh:'探索考索及周边更多景点' }[lang];
const intro = { en:'Discover river landscapes, rainforest highlights, lake viewpoints and practical itineraries in our 30 focused guides.', th:'ค้นพบแม่น้ำ น้ำตก พืชหายาก วิวทะเลสาบ และแผนเที่ยวจากคู่มือ 30 หัวข้อ', zh:'从索克河、森林瀑布到乔兰湖与行程规划，继续阅读 30 篇独立专题。' }[lang];
const all = { en:'Browse all 30 guides', th:'ดูคู่มือทั้ง 30 หัวข้อ', zh:'查看全部30篇指南' }[lang];
---
<section id="explore-nearby" class="py-20 bg-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-8">
      <div><p class="text-sm text-teak/65 uppercase tracking-widest">Khao Sok National Park</p><h2 class="font-display text-3xl md:text-4xl text-teak mt-2">{heading}</h2><p class="mt-3 max-w-2xl text-ink/75">{intro}</p></div>
      <a href={`/${lang}/explore/`} class="inline-flex shrink-0 rounded-full bg-teak text-ivory px-6 py-3 hover:bg-teakDeep">{all} →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {cards.map(e => <a href={`/${lang}/explore/${e[0]}/`} class="block rounded-2xl bg-white border border-teak/15 p-6 hover:border-gold hover:shadow-md transition-all">
        <p class="text-xs uppercase text-teak/60 tracking-wider">{e[1]}</p><h3 class="font-display text-xl text-teak mt-2">{lang === 'th' ? e[2] : lang === 'zh' ? e[4] : e[1]}</h3>
        <p class="text-sm text-ink/75 leading-relaxed mt-3">{lang === 'th' ? e[7] : lang === 'zh' ? e[8] : e[6]}</p>
        <span class="inline-block mt-4 text-teak text-sm font-semibold">{lang === 'th' ? 'อ่านเพิ่มเติม' : lang === 'zh' ? '了解更多' : 'Explore guide'} →</span>
      </a>)}
    </div>
  </div>
</section>
