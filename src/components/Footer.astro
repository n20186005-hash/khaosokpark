---
interface Props {
  lang: 'th' | 'en' | 'zh';
  messages: Record<string, any>;
  path?: string;
}
const { lang, messages } = Astro.props;
const legal = messages.footer;
const copyright = lang === 'zh'
  ? '© 2026 考索国家公园科普站 · 版权所有。'
  : lang === 'th'
    ? '© 2026 คู่มืออุทยานแห่งชาติเขาสก · สงวนลิขสิทธิ์'
    : '© 2026 Khao Sok National Park Guide · All rights reserved.';
const independent = lang === 'zh'
  ? '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。'
  : lang === 'th'
    ? 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ'
    : 'This is an independent travel information project, unaffiliated with any government agency or official organization.';
---
<footer class="bg-teakDeep text-ivory py-8 border-t border-gold/20">
  <div class="max-w-7xl mx-auto px-5 flex flex-col md:flex-row md:items-center justify-between gap-5">
    <div class="text-xs text-ivory/70 leading-relaxed space-y-2">
      <p>{copyright}</p>
      <p>{independent}</p>
    </div>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-ivory/70" aria-label="Site information">
      <a class="hover:text-goldBright" href={`/${lang}/sources/`}>{legal.sourcesTitle}</a>
      <a class="hover:text-goldBright" href={`/${lang}/privacy-policy/`}>{legal.privacy}</a>
      <a class="hover:text-goldBright" href={`/${lang}/terms-of-service/`}>{legal.terms}</a>
      <a class="hover:text-goldBright" href={`/${lang}/cookie-settings/`}>{legal.cookies}</a>
    </nav>
  </div>
</footer>
