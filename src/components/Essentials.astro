---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const e = messages.guide.essentials;

const hrefFor = (it: any) =>
  it.slug ? `/${lang}/${it.slug}/` : `#${it.hash}`;
---

<section id="essentials" class="py-16 bg-teakDeep text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{e.eyebrow}</p>
    <h2 class="font-display font-semibold text-3xl md:text-4xl mt-2">{e.title}</h2>
    <p class="mt-3 max-w-2xl text-ivory/80">{e.lead}</p>

    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {e.items.map((it: any) => (
        <a
          href={hrefFor(it)}
          class="group rounded-2xl border border-gold/25 bg-white/5 p-5 hover:border-gold hover:bg-gold/10 transition-colors"
        >
          <div class="text-xs uppercase tracking-wider text-goldBright">{it.label}</div>
          <div class="mt-2 font-display text-lg text-ivory leading-snug">{it.text}</div>
          <div class="mt-3 text-sm text-goldBright/90 group-hover:text-goldBright">
            {it.cta} →
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
