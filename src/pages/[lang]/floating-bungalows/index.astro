---
import { languagesList } from '../../../i18n/ui';
import { getI18n } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InfoPage from '../../../components/InfoPage.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang, slug: 'floating-bungalows' } }));
}

const { lang, messages } = await getI18n(Astro.url);
const slug = 'floating-bungalows';
const doc = messages.pages.bungalows;
---
<BaseLayout
  lang={lang}
  messages={messages}
  title={doc.meta.title}
  description={doc.meta.description}
  path={slug}
>
  <Header lang={lang} messages={messages} path={slug} />
  <InfoPage doc={doc} lang={lang} messages={messages} slug={slug} />
  <Footer lang={lang} messages={messages} path={slug} />
</BaseLayout>
