---
import { languagesList } from '../../../i18n/ui';
import { getI18n } from '../../../i18n/utils';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InfoPage from '../../../components/InfoPage.astro';

export function getStaticPaths() {
  return languagesList.map((lang) => ({ params: { lang, slug: 'floating-bungalows' } }));
}

const { lang, slug } = Astro.params;
const { messages } = getI18n(Astro.url);
const doc = messages.pages.bungalows;
---
<BaseLayout
  lang={lang}
  messages={messages}
  title={doc.meta.title}
  metaDescription={doc.meta.description}
  path={`/${lang}/${slug}/`}
>
  <InfoPage doc={doc} lang={lang} messages={messages} slug={slug} path={`/${lang}/${slug}/`} />
</BaseLayout>
