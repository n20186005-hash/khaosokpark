---
import { languagesList, getI18n } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Sources from '../../../components/Sources.astro';
import Footer from '../../../components/Footer.astro';
export function getStaticPaths() { return languagesList.map((lang) => ({ params: { lang } })); }
const { lang, messages } = await getI18n(Astro.url);
---
<BaseLayout lang={lang} title={messages.sources.heading} description={messages.sources.intro} messages={messages} path="sources">
  <Header lang={lang} messages={messages} path="sources" />
  <main class="pt-16">
    <Sources messages={messages} />
  </main>
  <Footer lang={lang} messages={messages} path="sources" />
</BaseLayout>
